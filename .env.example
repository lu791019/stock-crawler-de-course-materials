# Docker 配置
# DOCKER_HUB_USER=enzochang  # 替換為你的 Docker Hub 帳號

# RabbitMQ 配置
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672

# Celery Worker 配置  
WORKER_USERNAME=worker
WORKER_PASSWORD=worker

# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=1234
MYSQL_ROOT_PASSWORD=1234

# Airflow 配置
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASS=admin

# Metabase 配置
MB_DB_USER=metabase
MB_DB_PASS=metabase

# GCP 配置（雲端雙寫用）
# 不要在這裡設值：第 14 章 H-3 的 up 指令會用 shell 環境變數注入真實專案 ID；
# 本機（1-13 章）保持未設定，worker 會自動略過 BigQuery 寫入
# GCP_PROJECT_ID=your-project-id
