# Docker 配置
# DOCKER_HUB_USER=enzochang  # 替換為你的 Docker Hub 帳號

# ── 連線目標（compose 插值會讀這裡）─────────────────────────────
# 本機（1-13 章）：全部保持註解——compose 檔的預設值就是同機的容器服務名
#（rabbitmq、mysql），在自己電腦上直接跑的程式則用 config.py 的預設 127.0.0.1。
# 上雲搬家（手冊16 的 VM2）才把下面三行打開、填實際位址：
# RABBITMQ_HOST={VM1內部IP}
# MYSQL_HOST={CloudSQL IP}
# GCP_PROJECT_ID={你的專案ID}

# RabbitMQ 配置
RABBITMQ_PORT=5672

# Celery Worker 配置
WORKER_USERNAME=worker
WORKER_PASSWORD=worker

# MySQL 配置
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=1234
MYSQL_ROOT_PASSWORD=1234

# Airflow 配置
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASS=admin

# Metabase 配置
MB_DB_USER=metabase
MB_DB_PASS=metabase
