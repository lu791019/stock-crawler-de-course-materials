# Docker 配置
# DOCKER_HUB_USER=enzochang  # 替換為你的 Docker Hub 帳號

# ── 連線目標（compose 插值會讀這裡）─────────────────────────────
# 本機（1-13 章）：什麼都不用設——compose 檔的預設值就是同機的容器服務名
#（rabbitmq、mysql），在自己電腦上直接跑的程式則用 config.py 的預設 127.0.0.1。
# 上雲搬家（手冊16 的 VM2）需要 RABBITMQ_HOST / MYSQL_HOST / GCP_PROJECT_ID 三個值：
# 不要在這裡手動加——照手冊16 Part E 的指令，用 $(gcloud ...) 查值寫進檔尾，
# 手抄 IP 容易把佔位符的大括號留在檔案裡，.env 不會報錯，要到 worker 連線失敗才發現。

# RabbitMQ 配置
RABBITMQ_PORT=5672

# Celery Worker 配置
WORKER_USERNAME=worker
WORKER_PASSWORD=worker

# MySQL 配置
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=1234
MYSQL_ROOT_PASSWORD=1234

# Airflow 配置
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASS=admin

# Metabase 配置
MB_DB_USER=metabase
MB_DB_PASS=metabase
