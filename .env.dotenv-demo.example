# .env 帶入帳密示範 — 搭配 docker-compose-dotenv-demo.yml 使用
# 用法：cp .env.dotenv-demo.example .env.dotenv-demo（複製後的檔案不會進 git）
# 這裡故意用「跟預設不一樣」的帳密，讓你確認 .env 真的有被吃進去

# RabbitMQ 帳密（登入 http://localhost:15673 用這組）
RABBITMQ_USER=demo
RABBITMQ_PASS=demo-pass-123

# MySQL root 密碼（登入 phpMyAdmin http://localhost:8081 → root / 這個值）
# ⚠️ 只在資料卷第一次初始化時生效；改過要 down -v 重建才會換
MYSQL_ROOT_PASSWORD=demo-secret-999
MYSQL_DATABASE=demodb

# port 全部與主課程錯開，兩套可同時跑（不設就用 yml 裡 :-後面的預設值）
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15673
FLOWER_PORT=5556
MYSQL_PORT=3307
PHPMYADMIN_PORT=8081
