        </mxCell>

        <mxCell id="airflow" value="Airflow&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;:8081　排程觸發（第 10 到 12 章）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
