          <mxGeometry relative="1" as="geometry"><mxPoint x="395" y="340" as="sourcePoint" /><mxPoint x="125" y="340" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="n4" value="垂直虛線是每個元件的時間軸，由上往下代表時間經過；實線是發出的請求，虛線是回傳的結果。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
