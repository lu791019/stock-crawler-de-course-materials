        <mxCell id="c6" value="產出的檔案或報表&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;例如匯出的 CSV&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="230" y="305" width="170" height="45" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="235" width="55" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="接續點&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;線太長或跨頁時接回同代號&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="440" y="305" width="170" height="45" as="geometry" />
