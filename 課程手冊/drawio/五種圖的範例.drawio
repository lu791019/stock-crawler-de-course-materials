        <mxCell id="s8" value="" style="html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="690" y="262" as="sourcePoint" /><mxPoint x="800" y="262" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="c8" value="流向&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#666666&quot;&gt;整張圖由上到下、由左到右&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="660" y="305" width="180" height="45" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="這幾個是最常用的。畫的時候不必湊滿所有符號，用得到才用；同一份文件裡同一個形狀要固定代表同一件事。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="375" width="800" height="30" as="geometry" />
