        <mxCell id="r1lbl" value="一支股票有多筆每日股價" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="285" y="170" width="200" height="24" as="geometry" />
